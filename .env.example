# Copy to .env and fill in. Never commit .env.
# Provider: gemini (native REST) or openai (any OpenAI-compatible endpoint, e.g. Groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only for LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-oss-120b

# Optional
# DATA_DIR=data_eval
